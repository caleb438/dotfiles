# ~/.bash_aliases

# Enable colored output
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Directory listings
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Editors
alias vim='nvim'

# Terminal utilities
alias ff='fastfetch'

# Git
alias gs='git status'
alias ga='git add'
alias gc='git commit'
